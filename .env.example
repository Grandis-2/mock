# 이 파일을 .env 로 복사해 쓴다. .env 는 추적하지 않는다.
# 포트가 이미 쓰이고 있으면 MYSQL_PORT 만 바꾸면 된다.
# 바꿨으면 application.yml 의 datasource url 도 같은 포트로 맞춘다.

MYSQL_CONTAINER_NAME=nova-mock-mysql
MYSQL_PORT=3307

# MySQL 포트를 어느 주소에서 받을지. 기본은 이 PC 에서만(127.0.0.1).
# 부하를 다른 장비에서 쏘는 시험(하네스가 원장을 직접 읽음)만 0.0.0.0 으로 연다. 그때는
#   1. 아래 MYSQL_PASSWORD · MYSQL_ROOT_PASSWORD 를 기본값에서 바꾸고 application.yml 의 password 도 같이 고친다
#   2. docker compose down -v 뒤 docker compose up -d 로 DB 를 새로 만든다 — 계정 · 비밀번호는 볼륨을 처음 만들 때만
#      정해져서, 이미 만든 DB 는 .env 를 고쳐도 기본 비밀번호(nova · root) 그대로다. 데이터는 지워진다(부하 시험은 reset 으로 시작)
# 시험이 끝나면 127.0.0.1 로 되돌린다.
MYSQL_BIND=127.0.0.1

# Mock 을 여러 대로 띄울 때만 쓰는 Redis(docker compose --profile redis up -d). 평소에는 뜨지 않는다.
# 바꿨으면 application.yml 의 spring.data.redis.port 도 같은 값으로. 다른 장비의 Mock 이 붙을 때만 REDIS_BIND=0.0.0.0
REDIS_CONTAINER_NAME=nova-mock-redis
REDIS_PORT=6379
REDIS_BIND=127.0.0.1

# 이름은 바꾸지 않는다. docs/schema.sql 이 external_mock 을 직접 만들고 그 안에 테이블을 넣는다.
# 여기만 바꾸면 계정 권한이 붙는 database 와 테이블이 있는 database 가 갈라져,
# 기동할 때 "테이블이 없다" 로 실패한다. ERD 도 이 이름으로 고정돼 있다.
MYSQL_DATABASE=external_mock

MYSQL_USER=nova
MYSQL_PASSWORD=nova
MYSQL_ROOT_PASSWORD=root
